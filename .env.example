# Agent Observability Graph (AOG) Environment Configuration
# See https://github.com/shobhit-vision/aog for more information

# Database
AOG_DATABASE_URL=postgresql+asyncpg://aog:aog@localhost:5432/aog

# API
AOG_API_KEY=dev-key

# Logging
AOG_LOG_LEVEL=INFO

# Event export configuration
AOG_CAPTURE_INPUT=true
AOG_CAPTURE_OUTPUT=true
AOG_CAPTURE_TOOL_ARGS=true
AOG_CAPTURE_TOOL_RESULTS=true

AOG_MAX_PAYLOAD_BYTES=100000

# Export batching
AOG_EXPORT_BATCH_SIZE=50
AOG_EXPORT_FLUSH_INTERVAL_MS=500
AOG_EXPORT_QUEUE_SIZE=5000

# Fail-open by default — events are buffered if server unavailable
AOG_FAIL_OPEN=true